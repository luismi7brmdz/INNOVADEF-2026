<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Proxy /api/*, /report/*, /reports/* to Node server on port 3002
  RewriteRule ^(api|report|reports)(/.*)?$ http://localhost:3002/$1$2 [P,L]

  # SPA fallback
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
