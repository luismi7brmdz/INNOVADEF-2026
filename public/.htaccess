# ── Routing ───────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Proxy API/report/WebSocket routes to the Node server.
  # NOTE: the port (3002) MUST match PORT in server/.env on the deployment host.
  # Requires mod_proxy + mod_proxy_http (+ mod_proxy_wstunnel for the TTS socket).

  # WebSocket TTS proxy — must come BEFORE the HTTP rules.
  RewriteCond %{HTTP:Upgrade} =websocket [NC]
  RewriteRule ^ws-tts(.*)$ ws://127.0.0.1:3002/ws-tts$1 [P,L]

  # HTTP API / reports proxy.
  RewriteRule ^api/(.*)$     http://127.0.0.1:3002/api/$1     [P,L]
  RewriteRule ^report/(.*)$  http://127.0.0.1:3002/report/$1  [P,L]
  RewriteRule ^reports/(.*)$ http://127.0.0.1:3002/reports/$1 [P,L]

  # SPA fallback — serve index.html for all unknown paths
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ── Compression (on-the-fly) ──────────────────────────────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Cache headers ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>

# ── Cache: hashed assets → 1 year ────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType font/ttf               "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>