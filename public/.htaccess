# ── Compresión ────────────────────────────────────────────────────────────────
# Prioridad: servir archivos pre-comprimidos (.br / .gz) generados por Vite.
# Solo aplica a /assets/ (hashed filenames) — no interfiere con SPA ni proxy.
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_URI}          ^/assets/
  RewriteCond %{REQUEST_FILENAME}.br  -f
  RewriteRule ^ %{REQUEST_FILENAME}.br [L]

  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_URI}          ^/assets/
  RewriteCond %{REQUEST_FILENAME}.gz  -f
  RewriteRule ^ %{REQUEST_FILENAME}.gz [L]
</IfModule>

# Content-Type y Content-Encoding correctos para los archivos comprimidos
<FilesMatch "\.js\.br$">  ForceType application/javascript </FilesMatch>
<FilesMatch "\.css\.br$"> ForceType text/css               </FilesMatch>
<FilesMatch "\.js\.gz$">  ForceType application/javascript </FilesMatch>
<FilesMatch "\.css\.gz$"> ForceType text/css               </FilesMatch>
<FilesMatch "\.(gz)$">
  Header set   Content-Encoding "gzip"
  Header append Vary             "Accept-Encoding"
</FilesMatch>
<FilesMatch "\.(br)$">
  Header set   Content-Encoding "br"
  Header append Vary             "Accept-Encoding"
</FilesMatch>

# Fallback: compresión en vuelo para lo que no tenga versión pre-comprimida
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Cache: assets con hash → 1 año; index.html → sin cache ───────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType font/ttf               "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>
<Files "index.html">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>

# ── Routing ───────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Proxy /api/*, /report/*, /reports/* to Node server on port 3002
  RewriteRule ^(api|report|reports)(/.*)?$ http://localhost:3002/$1$2 [P,L]

  # SPA fallback
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
