{
  "name": "innovadef-kiosk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node --env-file=server/.env server/index.js",
    "dev:full": "concurrently -n VITE,API -c cyan,green \"vite\" \"node --env-file=server/.env server/index.js\"",
    "dev:network": "concurrently -n VITE,API -c cyan,green \"vite --host\" \"node --env-file=server/.env server/index.js\"",
    "start": "npm run build && concurrently -n PREVIEW,API -c cyan,green \"vite preview\" \"node --env-file=server/.env server/index.js\""
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "knex": "^3.2.10",
    "lucide-react": "^1.16.0",
    "mysql2": "^3.22.3",
    "nodemailer": "^7.0.3",
    "openai": "^6.38.0",
    "pdfkit": "^0.15.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "three": "^0.184.0",
    "uuid": "^11.1.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
