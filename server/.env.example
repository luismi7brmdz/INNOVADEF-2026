# ─────────────────────────────────────────────────────────────────────────────
# INNOVADEF Kiosk — Server configuration
# Copy this file to server/.env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Database ──────────────────────────────────────────────────────────────────
# MariaDB/MySQL for production (cPanel). If unset, falls back to SQLite.
# Format: mysql://user:password@host:3306/dbname
# DATABASE_URL=mysql://innovadef:password@localhost/innovadef

# ── xAI (Grok) ────────────────────────────────────────────────────────────────
# Used server-side to proxy /api/xai/* — never exposed to the client bundle.
# Get your key at https://console.x.ai
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── SMTP (outgoing email) ─────────────────────────────────────────────────────
# Example with Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password
#
# Example with Brevo (Sendinblue):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your-login@example.com
#   SMTP_PASS=your-api-key
#
# Example with OVH / generic:
#   SMTP_HOST=ssl0.ovh.net
#   SMTP_PORT=587
#   SMTP_USER=noreply@innovadef.es
#   SMTP_PASS=password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@innovadef.es
SMTP_PASS=your-password-here
SMTP_FROM="INNOVADEF FOCO 2026 <noreply@innovadef.es>"
